---
// Fullscreen looping hero video (YouTube) with mute toggle
const YOUTUBE_ID = "ajZ6FcuYqf0";
---

<main class="seaction-header-main">
  <div id="canvas" class="canvas"></div>
  <div
    class="header_background-image youtube-hero-video"
    style={`background-image:url(https://i.ytimg.com/vi/${YOUTUBE_ID}/hqdefault.jpg)`}
  >
    <div id="hero-youtube-player" data-video-id={YOUTUBE_ID}></div>
  </div>
  <button
    id="hero-mute-toggle"
    class="youtube-hero-video_mute-toggle"
    type="button"
    aria-label="Unmute video"
    aria-pressed="false"
  >
    <svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 9v6h4l5 5V4L7 9H3z" fill="currentColor" />
      <path d="M16 8l5 8M21 8l-5 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <svg class="icon-unmuted" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 9v6h4l5 5V4L7 9H3z" fill="currentColor" />
      <path
        d="M16.5 8.5a5 5 0 0 1 0 7M19 6a9 9 0 0 1 0 12"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  </button>
</main>

<script>
  declare global {
    interface Window {
      onYouTubeIframeAPIReady?: () => void;
      YT?: any;
    }
  }

  const mount = document.getElementById("hero-youtube-player");
  const toggle = document.getElementById("hero-mute-toggle");
  if (mount && toggle) {
    const videoId = mount.dataset.videoId as string;
    let player: any = null;
    let muted = true;

    const createPlayer = () => {
      player = new window.YT.Player(mount, {
        videoId,
        playerVars: {
          autoplay: 1,
          mute: 1,
          controls: 0,
          modestbranding: 1,
          rel: 0,
          iv_load_policy: 3,
          cc_load_policy: 0,
          disablekb: 1,
          fs: 0,
          playsinline: 1,
          origin: window.location.origin,
        },
        events: {
          onReady: (event: any) => {
            event.target.getIframe()?.classList.add("is-loaded");
            event.target.mute();
            event.target.playVideo();
          },
          onStateChange: (event: any) => {
            // Loop manually instead of via loop+playlist params: that combo
            // puts the player into "playlist mode", which shows prev/next
            // controls we can't otherwise suppress.
            if (event.data === window.YT.PlayerState.ENDED) {
              event.target.seekTo(0);
              event.target.playVideo();
            }
          },
        },
      });
    };

    if (window.YT && window.YT.Player) {
      createPlayer();
    } else {
      const existingCallback = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        existingCallback?.();
        createPlayer();
      };
      if (!document.querySelector('script[src="https://www.youtube.com/iframe_api"]')) {
        const tag = document.createElement("script");
        tag.src = "https://www.youtube.com/iframe_api";
        document.head.appendChild(tag);
      }
    }

    toggle.addEventListener("click", () => {
      if (!player) return;
      muted = !muted;
      if (muted) {
        player.mute();
      } else {
        player.unMute();
      }
      toggle.classList.toggle("is-unmuted", !muted);
      toggle.setAttribute("aria-pressed", String(!muted));
      toggle.setAttribute("aria-label", muted ? "Unmute video" : "Mute video");
    });
  }
</script>
