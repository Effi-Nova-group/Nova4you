---
// Fullscreen looping hero video (YouTube) with mute toggle.
// Matches the proven pattern used across the other Nova Group sites:
// a plain autoplaying iframe (no iframe_api.js load, so it starts
// immediately), no loop+playlist params (that puts YouTube into
// "playlist mode" and flashes its own prev/pause/next chrome), and
// manual looping via postMessage onStateChange -> ended -> seekTo(0).
const YOUTUBE_ID = "ajZ6FcuYqf0";
---

<main class="seaction-header-main">
  <div id="canvas" class="canvas"></div>
  <div class="header_background-image hero-video-wrap">
    <iframe
      id="hero-yt-player"
      src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_ID}?autoplay=1&mute=1&controls=0&disablekb=1&fs=0&iv_load_policy=3&modestbranding=1&playsinline=1&rel=0&showinfo=0&enablejsapi=1`}
      title="Hero background video"
      frameborder="0"
      allow="autoplay; encrypted-media"
      aria-hidden="true"
      tabindex="-1"
    ></iframe>
  </div>
  <button
    id="hero-mute-toggle"
    class="hero-mute-toggle is-muted"
    type="button"
    aria-label="Unmute video"
    aria-pressed="true"
  >
    <svg class="icon-muted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor" />
      <line x1="17" y1="9" x2="23" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <line x1="23" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor" />
      <path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M19 6a9 9 0 0 1 0 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  </button>
</main>

<script>
  const iframe = document.getElementById("hero-yt-player") as HTMLIFrameElement | null;
  const toggle = document.getElementById("hero-mute-toggle") as HTMLButtonElement | null;
  let muted = true;

  const updateToggle = () => {
    if (!toggle) return;
    toggle.classList.toggle("is-muted", muted);
    toggle.setAttribute("aria-pressed", String(muted));
    toggle.setAttribute("aria-label", muted ? "Unmute video" : "Mute video");
  };
  updateToggle();

  const sendCommand = (func: string, args: unknown[] = []) => {
    iframe?.contentWindow?.postMessage(JSON.stringify({ event: "command", func, args }), "*");
  };

  toggle?.addEventListener("click", () => {
    muted = !muted;
    sendCommand(muted ? "mute" : "unMute");
    updateToggle();
  });

  iframe?.addEventListener("load", () => {
    sendCommand("addEventListener", ["onStateChange"]);
  });

  window.addEventListener("message", (event) => {
    if (!/(^|\.)youtube(-nocookie)?\.com$/.test(new URL(event.origin).hostname)) return;
    let data: any;
    try {
      data = JSON.parse(event.data);
    } catch {
      return;
    }
    if (data.event === "onStateChange" && data.info === 0) {
      sendCommand("seekTo", [0, true]);
      sendCommand("playVideo");
    }
  });
</script>
