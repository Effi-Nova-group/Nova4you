---
// Fullscreen looping hero video (local file) with mute toggle.
// Desktop: full width, never cropped (object-fit: contain).
// Mobile: hero section is 50vh and the video fills that box completely,
// so slight left/right cropping is expected there (object-fit: cover).
---

<main class="seaction-header-main">
  <div id="canvas" class="canvas"></div>
  <div class="header_background-image hero-video-wrap">
    <video
      id="hero-video"
      class="hero-video"
      src="/videos/hero-video.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
      tabindex="-1"
    ></video>
  </div>
  <button
    id="hero-mute-toggle"
    class="hero-mute-toggle is-muted"
    type="button"
    aria-label="Unmute video"
    aria-pressed="true"
  >
    <svg class="icon-muted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor" />
      <line x1="17" y1="9" x2="23" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      <line x1="23" y1="9" x2="17" y2="15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
    </svg>
    <svg class="icon-unmuted" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M4 9v6h4l5 5V4L8 9H4z" fill="currentColor" />
      <path d="M16.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      <path d="M19 6a9 9 0 0 1 0 12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>
  </button>
</main>

<script>
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  const toggle = document.getElementById("hero-mute-toggle") as HTMLButtonElement | null;

  const updateToggle = () => {
    if (!toggle || !video) return;
    const muted = video.muted;
    toggle.classList.toggle("is-muted", muted);
    toggle.setAttribute("aria-pressed", String(muted));
    toggle.setAttribute("aria-label", muted ? "Unmute video" : "Mute video");
  };
  updateToggle();

  toggle?.addEventListener("click", () => {
    if (!video) return;
    video.muted = !video.muted;
    updateToggle();
  });

  video?.addEventListener("volumechange", updateToggle);

  video?.play().catch(() => {
    /* autoplay was blocked; browser will resume on user interaction */
  });
</script>
