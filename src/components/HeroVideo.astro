---
// Fullscreen looping hero video (YouTube) with mute toggle
const YOUTUBE_ID = "ajZ6FcuYqf0";
---

<main class="seaction-header-main">
  <div id="canvas" class="canvas"></div>
  <div
    class="header_background-image youtube-hero-video"
    style={`background-image:url(https://i.ytimg.com/vi/${YOUTUBE_ID}/maxresdefault.jpg)`}
  >
    <iframe
      id="hero-youtube-iframe"
      class="youtube-hero-video_iframe"
      src={`https://www.youtube-nocookie.com/embed/${YOUTUBE_ID}?autoplay=1&mute=1&loop=1&playlist=${YOUTUBE_ID}&controls=0&modestbranding=1&rel=0&iv_load_policy=3&cc_load_policy=0&disablekb=1&fs=0&playsinline=1&enablejsapi=1`}
      title="Hero background video"
      frameborder="0"
      allow="autoplay; encrypted-media"
      allowfullscreen
      loading="eager"
      onload="this.classList.add('is-loaded')"
    ></iframe>
  </div>
  <button
    id="hero-mute-toggle"
    class="youtube-hero-video_mute-toggle"
    type="button"
    aria-label="Unmute video"
    aria-pressed="false"
  >
    <svg class="icon-muted" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 9v6h4l5 5V4L7 9H3z" fill="currentColor" />
      <path d="M16 8l5 8M21 8l-5 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
    </svg>
    <svg class="icon-unmuted" width="20" height="20" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M3 9v6h4l5 5V4L7 9H3z" fill="currentColor" />
      <path
        d="M16.5 8.5a5 5 0 0 1 0 7M19 6a9 9 0 0 1 0 12"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
      />
    </svg>
  </button>
</main>

<script>
  const iframe = document.getElementById("hero-youtube-iframe") as HTMLIFrameElement | null;
  const toggle = document.getElementById("hero-mute-toggle");

  if (iframe && toggle) {
    let muted = true;

    const postCommand = (func: string) => {
      iframe.contentWindow?.postMessage(JSON.stringify({ event: "command", func, args: [] }), "*");
    };

    toggle.addEventListener("click", () => {
      muted = !muted;
      postCommand(muted ? "mute" : "unMute");
      toggle.classList.toggle("is-unmuted", !muted);
      toggle.setAttribute("aria-pressed", String(!muted));
      toggle.setAttribute("aria-label", muted ? "Unmute video" : "Mute video");
    });
  }
</script>
