---
// Shared site header (Webflow nav)

// Trailing-slash-insensitive current-section match for nav highlighting
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<style is:global>
  /* Keep the "Get started" button visible on tablet/mobile. Webflow's stock
     CSS hides .header-left entirely below 992px and expects an ix2 mobile
     menu, which we don't ship — so we force the CTA to stay and drop the
     broken hamburger button. */
  @media screen and (max-width: 991px) {
    .header .split-content.header-left {
      display: flex !important;
      align-items: center;
      gap: 12px;
    }
    .header .menu-button { display: none !important; }
    .header .split-content.header-left .nav-link.sign-in.none { display: none !important; }
    .header .split-content.header-left .button-primary-gradient.header-button {
      display: inline-block !important;
      margin-right: 0;
    }
  }
  @media screen and (max-width: 479px) {
    .header .button-primary.small-v2 { padding: 12px 20px; font-size: 0.95rem; }
  }

  /* --- Case Studies / Blog links ------------------------------------------
     .header-navigation.none hides the stock Webflow menu, so these live in
     their own list. The current page reads at full strength, the rest muted. */
  .header .header-navigation.site-nav {
    display: flex;
    /* nova4you.webflow.css flips .header-navigation to column below 992px for the
       collapsed Webflow panel. This list isn't in that panel, so hold it to a row. */
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 32px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .header .header-navigation.site-nav .nav-item-wrapper { margin: 0; }
  .header .header-navigation.site-nav .nav-link {
    color: rgba(244, 240, 232, 0.65);
    white-space: nowrap;
    transition: color 0.2s ease;
  }
  .header .header-navigation.site-nav .nav-link:hover,
  .header .header-navigation.site-nav .nav-link:focus-visible { color: #fff; }
  .header .header-navigation.site-nav .nav-link[aria-current='page'] { color: #fff; font-weight: 600; }

  /* .header-wrapper is a space-between flex row (logo | links | CTA). Equal gaps
     push the links off true centre because the logo and the CTA button are
     different widths, so pin the link group to the centre instead. */
  @media screen and (min-width: 992px) {
    .header .header-wrapper { position: relative; }
    .header .split-content.header-center {
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
    }
  }

  /* Below the Webflow collapse point the links sit inline between the logo and
     the CTA, so step the gap down to keep the row on one line. */
  @media screen and (max-width: 991px) {
    .header .header-navigation.site-nav { gap: 24px; }
  }

  /* Narrow enough that logo + links + CTA can't share a line without the CTA
     label breaking. Wrap the links onto their own centred row underneath. */
  /* Grid rather than flex-wrap: a wrapping flex row breaks items onto new lines
     before it shrinks them, which would drop the CTA below the logo. The grid
     pins logo and CTA to row one and gives the links a row of their own, while
     minmax(0, 1fr) lets the logo scale down to whatever width is left. */
  @media screen and (max-width: 860px) {
    .header .header-wrapper {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        "logo cta"
        "nav  nav";
      align-items: center;
      column-gap: 12px;
      row-gap: 10px;
    }
    .header .split-content.header-right { grid-area: logo; min-width: 0; }
    .header .split-content.header-right .header-logo { max-width: 100%; height: auto; }
    .header .split-content.header-left { grid-area: cta; margin-right: 0; }
    /* width:100%, not justify-self: the item's used width resolves from the
       Webflow flex rules and doesn't stretch to the area on its own, which
       parks the links against the right edge. */
    .header .split-content.header-center {
      grid-area: nav;
      width: 100%;
      justify-content: center;
      margin-right: 0;
    }
    .header .header-navigation.site-nav { gap: 28px; }
    .header .header-navigation.site-nav .nav-link { font-size: 0.95rem; }
  }
</style>



<div
  data-animation="over-left"
  class="header w-nav"
  data-easing2="ease"
  data-easing="ease"
  data-collapse="medium"
  data-w-id="14156406-4018-c65c-a1c8-d57b8e657956"
  role="banner"
  data-duration="400"
>
  <div class="container-default w-container">
    <div class="header-wrapper">
      <div class="split-content header-right">
        <a href="/" class="brand w-nav-brand">
          <img src="/images/Screenshot-2026-07-24-at-10.30.50-am-1.png" alt="Nova4you" class="header-logo" />
        </a>
      </div>
      <div class="split-content header-center">
        {/* Sits outside .w-nav-menu on purpose: Webflow's data-collapse="medium"
            hides .w-nav-menu below 992px and expects the hamburger panel, which
            this site doesn't ship. Keeping these two links out here means they
            stay reachable at every width. */}
        <ul role="list" class="header-navigation site-nav w-list-unstyled">
          <li class="nav-item-wrapper">
            <a href="/case-studies/" class="nav-link" aria-current={isCurrent('/case-studies') ? 'page' : undefined}>Case Studies</a>
          </li>
          <li class="nav-item-wrapper">
            <a href="/blogs/" class="nav-link" aria-current={isCurrent('/blogs') ? 'page' : undefined}>Blog</a>
          </li>
        </ul>
        <nav role="navigation" data-w-id="14156406-4018-c65c-a1c8-d57b8e65795d" class="nav-menu w-nav-menu">
          <ul role="list" class="header-navigation none w-list-unstyled">
            <li class="nav-item-wrapper"><a href="/" class="nav-link">Home</a></li>
            <li class="nav-item-wrapper"><a href="/#about" class="nav-link">About</a></li>
            <li class="nav-item-wrapper"><a href="/#" class="nav-link">Pricing</a></li>
            <li class="nav-item-wrapper">
              <div data-hover="true" data-delay="0" data-w-id="14156406-4018-c65c-a1c8-d57b8e657969" class="nav-link-dropdown w-dropdown">
                <div class="nav-link dropdown w-dropdown-toggle">
                  <div>Pages <span class="dropdown-arrow"></span></div>
                </div>
                <nav data-w-id="14156406-4018-c65c-a1c8-d57b8e65796f" class="dropdown-list w-dropdown-list">
                  <div class="dropdown-nav-main-wrapper">
                    <div class="dropdown-nav-pages-wrapper">
                      <div class="title dropdown">Menu</div>
                      <div class="dropdown-nav-content">
                        <ul role="list" class="dropdown-nav">
                          <li class="dropdown-nav-item"><a href="/" class="dropdown-nav-link">Home</a></li>
                          <li class="dropdown-nav-item"><a href="/#about" class="dropdown-nav-link">About</a></li>
                          <li class="dropdown-nav-item"><a href="/#contact" class="dropdown-nav-link">Contact</a></li>
                          <li class="dropdown-nav-item"><a href="/blogs/" class="dropdown-nav-link">Blog</a></li>
                        </ul>
                      </div>
                    </div>
                  </div>
                </nav>
              </div>
            </li>
            <li class="nav-item-wrapper mobile"><a href="/#contact" class="nav-link sign-in mobile">Sign in</a></li>
            <li class="nav-item-wrapper mobile-button">
              <div class="button-primary-gradient header-button mobile-button">
                <a href="/#contact" class="button-primary small-v2 mobile-button w-button">Get started</a>
              </div>
            </li>
          </ul>
        </nav>
      </div>
      <div class="split-content header-left">
        <a href="/#contact" class="nav-link sign-in none">Sign in</a>
        <div class="button-primary-gradient header-button">
          <a href="/#contact" class="button-primary small-v2 w-button">Get started</a>
        </div>
        <div class="menu-button w-nav-button">
          <div class="header-menu-button-icon-wrapper">
            <div class="icon-wrapper">
              <div class="header-menu-button-icon-top"></div>
              <div class="header-menu-button-icon-medium"></div>
              <div class="header-menu-button-icon-bottom"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
