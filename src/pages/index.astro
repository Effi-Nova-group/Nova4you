---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import EdgeSection from '../components/EdgeSection.astro';
import ServicesSection from '../components/ServicesSection.astro';
import AboutSection from '../components/AboutSection.astro';
import LogoMarquee from '../components/LogoMarquee.astro';
import BentoInsights from '../components/BentoInsights.astro';
import ContactForm from '../components/ContactForm.astro';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://nova4you.com/#organization',
      name: 'The Nova Group',
      alternateName: 'Nova4you',
      url: 'https://nova4you.com/',
      logo: 'https://nova4you.com/images/Screenshot-2026-07-24-at-10.30.50-am-1.png',
      description: 'Nova4You is a next-generation marketing and advertising agency bridging the gap between traditional media and AI-driven digital innovation.',
      telephone: '+61-1300-926-895',
      areaServed: 'AU',
    },
    {
      '@type': 'WebSite',
      '@id': 'https://nova4you.com/#website',
      url: 'https://nova4you.com/',
      name: 'Nova4you',
      publisher: { '@id': 'https://nova4you.com/#organization' },
      inLanguage: 'en-AU',
    },
    {
      '@type': 'WebPage',
      '@id': 'https://nova4you.com/#webpage',
      url: 'https://nova4you.com/',
      name: 'Nova4You — The Future of Advertising, Engineered for Growth',
      isPartOf: { '@id': 'https://nova4you.com/#website' },
      about: { '@id': 'https://nova4you.com/#organization' },
      description:
        'Nova4You is a next-generation marketing and advertising agency bridging the gap between traditional media and AI-driven digital innovation.',
    },
  ],
};
---

<BaseLayout
  title="Nova4You — The Future of Advertising, Engineered for Growth"
  description="Nova4You is a next-generation marketing and advertising agency bridging the gap between traditional media and AI-driven digital innovation."
  canonical="https://nova4you.com/"
  keywords="AI marketing agency, advertising agency Australia, AI digital marketing, TV advertising, radio advertising, customer experience technology, CX, programmatic advertising, Nova4You"
  ogTitle="Nova4You — The Future of Advertising, Engineered for Growth"
  ogDescription="We fuse advanced AI-driven digital marketing, prime-time TV & Radio, and hyper-personalized Customer Experience (CX) technologies to scale your brand."
  ogImage="https://nova4you.com/images/impact-hero.jpg"
  ogImageAlt="Nova4You — AI-driven advertising engineered for growth"
  twitterDescription="Nova4You is a next-generation marketing and advertising agency bridging the gap between traditional media and AI-driven digital innovation."
  includeBlogCss
  jsonLd={jsonLd}
>
  <link slot="head" rel="stylesheet" href="/css/home.css?v=heroOverlay2" />
  <HeroVideo />
  <EdgeSection />
  <ServicesSection />
  <AboutSection />
  <LogoMarquee />
  <BentoInsights />
  <ContactForm />
</BaseLayout>
