---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCard from '../../components/BlogCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf(),
);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Nova4you Insights',
  description: 'Perspectives on modern marketing from The Nova Group.',
  url: 'https://nova4you.com/blogs/',
  isPartOf: { '@type': 'WebSite', name: 'Nova4you', url: 'https://nova4you.com/' },
  publisher: {
    '@type': 'Organization',
    name: 'The Nova Group',
    logo: {
      '@type': 'ImageObject',
      url: 'https://nova4you.com/images/Screenshot-2026-07-24-at-10.30.50-am-1.png',
    },
  },
};
---

<BaseLayout
  title="Insights — Nova4you | Perspectives on Modern Marketing"
  description="Ideas, frameworks and field notes from The Nova Group — spanning advertising, PR, customer experience, growth and specialist health marketing."
  canonical="https://nova4you.com/blogs/"
  keywords="marketing insights, advertising strategy, PR strategy, customer experience, growth marketing, healthcare marketing, borderless creativity"
  ogTitle="Insights — Nova4you | Perspectives on Modern Marketing"
  ogDescription="Ideas, frameworks and field notes from The Nova Group — spanning advertising, PR, CX, growth and specialist health marketing."
  ogImage="https://nova4you.com/images/impact-hero.jpg"
  twitterTitle="Insights — Nova4you"
  twitterDescription="Ideas, frameworks and field notes from The Nova Group."
  bodyClass="blog-body body"
  includeBlogCss
  jsonLd={jsonLd}
>
  <section class="blog-hero">
    <div class="blog-hero-eyebrow">Insights · {posts.length.toString().padStart(2, '0')}</div>
    <h1>Borderless perspectives on modern marketing.</h1>
    <p>Ideas, frameworks and field notes from The Nova Group — spanning advertising, PR, customer experience, growth and specialist health marketing.</p>
  </section>

  <section class="blog-grid">
    {posts.map((post) => <BlogCard post={post} />)}
  </section>
</BaseLayout>
